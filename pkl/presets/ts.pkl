amends "base.pkl"

import "../builtins.pkl" as tsBuiltins

local nodeModulesPath = new Mapping<String, String> {
  ["PATH"] = "node_modules/.bin:\(read("env:PATH"))"
}

steps {
  ["oxfmt"] = (tsBuiltins.oxfmt) {
    env = nodeModulesPath
  }
  ["oxlint"] = (tsBuiltins.ox_lint) {
    depends = List("oxfmt")
    env = nodeModulesPath
  }
  ["types"] {
    check = "bun run typecheck"
    profiles = List("slow")
  }
  ["test"] {
    check = "bun run test"
    profiles = List("slow")
  }
}
