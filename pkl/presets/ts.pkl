amends "base.pkl"

import "../builtins.pkl" as tsBuiltins

steps {
  ["oxfmt"] = tsBuiltins.oxfmt
  ["oxlint"] = (tsBuiltins.ox_lint) {
    depends = List("oxfmt")
  }
  ["types"] {
    check = "bun run typecheck"
    profiles = List("slow")
  }
  ["test"] {
    check = "bun run test"
    profiles = List("slow")
  }
}
